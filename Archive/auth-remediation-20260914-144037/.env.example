# ==============================================================================
# SUPABASE CONFIGURATION
# Lấy từ Project Settings > API trên https://supabase.com/dashboard
# ==============================================================================

# Project URL (Bắt buộc)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Project Anon Public Key (Bắt buộc)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# (Tùy chọn - chỉ dùng cho backend script seed)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ==============================================================================
# OPENROUTER AI CONFIGURATION (Server Secrets via Supabase Edge Function)
# Lưu ý: Tuyệt đối không đặt API key vào frontend VITE_*
# ==============================================================================
# OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here
# OPENROUTER_MODEL=openrouter/free

# ==============================================================================
# TELEGRAM BOT CONFIGURATION (Server Secrets via Supabase Edge Function notify-telegram)
# Tạo Bot qua @BotFather và lấy Chat ID từ @userinfobot
# ==============================================================================
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
# TELEGRAM_CHAT_ID=123456789
